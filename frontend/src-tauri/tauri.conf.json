{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-agent",
  "version": "0.1.0",
  "identifier": "com.multiagent.app",
  "build": {
    "beforeDevCommand": "bash scripts/dev.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/build.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Multi-agent · 多 Agent 协作",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/multiagent-backend"]
  }
}
